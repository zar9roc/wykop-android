<?xml version="1.0" encoding="utf-8"?>
<!-- Odpowiedz: wiersz jak inne pozycje (ikona + tekst) bedacy inputem (tap => klawiatura).
     X na koncu (widoczny od 3. odpowiedzi) cofa dodanie tej odpowiedzi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    >

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_radio_unchecked"
        app:tint="?android:attr/textColorPrimary"
        />

    <EditText
        android:id="@+id/answerInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/bottomsheet_item_textview_margin_left"
        android:layout_weight="1"
        android:background="@null"
        android:hint="@string/survey_answer_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="100"
        android:padding="0dp"
        android:textColorHint="?attr/textColorLight"
        android:textSize="?attr/textSizeNormal"
        />

    <ImageView
        android:id="@+id/answerRemove"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/survey_remove_answer"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        android:visibility="gone"
        app:tint="?android:attr/textColorPrimary"
        />
</LinearLayout>
