import kotlin.Float;
import kotlin.Int;
import kotlin.Boolean;
import io.github.wykopmobilny.data.cache.api.UserVote;
import kotlinx.datetime.Instant;

CREATE TABLE linkEntity (
    id INTEGER NOT NULL UNIQUE PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    tags TEXT NOT NULL,
    sourceUrl TEXT NOT NULL,
    previewImageUrl TEXT,
    fullImageUrl TEXT,
    voteCount INTEGER AS Int NOT NULL,
    buryCount INTEGER AS Int NOT NULL,
    commentsCount INTEGER AS Int NOT NULL,
    relatedCount INTEGER AS Int NOT NULL,
    postedAt INTEGER AS Instant NOT NULL,
    plus18 INTEGER AS Boolean NOT NULL,
    canVote INTEGER AS Boolean NOT NULL,
    isHot INTEGER AS Boolean NOT NULL,
    userVote INTEGER AS UserVote,
    userFavorite INTEGER AS Boolean NOT NULL,
    userObserve INTEGER AS Boolean NOT NULL,
    app TEXT,
    profileId TEXT NOT NULL,
    FOREIGN KEY (profileId) REFERENCES profileEntity(id)
);

insertOrReplace:
INSERT OR REPLACE INTO linkEntity
VALUES ?;

vote:
UPDATE linkEntity
SET
  voteCount = :voteCount,
  buryCount = :buryCount,
  userVote = :userVote
WHERE id = :id;

-- Zmiana glosu przenosi go miedzy licznikami: wykop po zakopie zdejmuje zakop (i odwrotnie),
-- a ponowny glos w te sama strone nic nie dolicza. Wczesniej zakop po wykopie dodawal tylko
-- zakop - licznik wykopow (wynik znaleziska) nie spadal az do odswiezenia.
-- W UPDATE wszystkie wyrazenia widza STARE wartosci wiersza, wiec CASE patrzy na poprzedni glos.
voteUpOptimistic:
UPDATE linkEntity
SET
  voteCount = CASE WHEN userVote = :up THEN voteCount ELSE voteCount + 1 END,
  buryCount = CASE WHEN userVote = :down THEN MAX(buryCount - 1, 0) ELSE buryCount END,
  userVote = :up
WHERE id = :id;

voteDownOptimistic:
UPDATE linkEntity
SET
  buryCount = CASE WHEN userVote = :down THEN buryCount ELSE buryCount + 1 END,
  voteCount = CASE WHEN userVote = :up THEN MAX(voteCount - 1, 0) ELSE voteCount END,
  userVote = :down
WHERE id = :id;

removeVoteOptimistic:
UPDATE linkEntity
SET
  voteCount = CASE WHEN userVote = :wasUp THEN MAX(voteCount - 1, 0) ELSE voteCount END,
  buryCount = CASE WHEN userVote = :wasDown THEN MAX(buryCount - 1, 0) ELSE buryCount END,
  userVote = NULL
WHERE id = :id;

selectById:
SELECT
  linkEntity.*,
  profileEntity.rank,
  profileEntity.color,
  profileEntity.gender,
  profileEntity.avatar
FROM linkEntity
JOIN profileEntity ON linkEntity.profileId = profileEntity.id
WHERE linkEntity.id = ?;

deleteById:
DELETE FROM linkEntity
WHERE id = ?;
