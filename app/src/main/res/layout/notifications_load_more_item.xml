<?xml version="1.0" encoding="utf-8"?>
<!-- Stopka listy powiadomien: jawny przycisk "pokaz starsze". Lista NIE doladowuje
     sie sama przy scrollu - jedno klikniecie = jedno zapytanie = jedna strona. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loadMoreItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/itemBackgroundColorStatelist"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="48dp"
    android:paddingTop="@dimen/padding_dp_large"
    android:paddingBottom="@dimen/padding_dp_large"
    >

    <TextView
        android:id="@+id/loadMoreLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingLeft="@dimen/padding_dp_huge"
        android:paddingRight="@dimen/padding_dp_huge"
        android:text="@string/notifications_load_more"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="?attr/textSizeNormal"
        />

    <ProgressBar
        android:id="@+id/loadMoreProgress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="visible"
        />

</FrameLayout>
