<?xml version="1.0" encoding="utf-8"?>
<!-- Jedna strona przegladarki zdjec (PhotoViewActivity). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <com.davemorrissey.labs.subscaleview.SubsamplingScaleImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />

    <!-- PhotoView (zoom/pan) zamiast ImageView - bardzo wysokie gify sa dekodowane
         w pomniejszeniu (limit tekstury GPU), wiec bez zoomu bylyby nieczytelne. -->
    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/gif"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        />

    <!-- Postep pobierania pod paskiem narzedzi (ten lezy nad pagerem). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/actionBarSize"
        android:orientation="vertical"
        >

        <ProgressBar
            android:id="@+id/loadingView"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:max="100"
            android:progress="0"
            />

        <TextView
            android:id="@+id/progressLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:shadowColor="@android:color/black"
            android:shadowRadius="4"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone"
            />

    </LinearLayout>

</FrameLayout>
