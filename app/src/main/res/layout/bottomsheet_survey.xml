<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/backgroundColor"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/survey_dialog_title"
            android:textSize="@dimen/bottomsheet_item_title_text_size"
            />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/separator_line_height"
            android:background="?attr/lineColor"
            />

        <!-- Pytanie: wiersz jak inne pozycje (ikona + tekst), ale bedacy inputem -
             tap fokusuje i podnosi klawiature. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            >

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_help"
                app:tint="?android:attr/textColorPrimary"
                />

            <EditText
                android:id="@+id/surveyQuestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/bottomsheet_item_textview_margin_left"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/survey_question_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="255"
                android:padding="0dp"
                android:textColorHint="?attr/textColorLight"
                android:textSize="?attr/textSizeNormal"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/answersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            />

        <LinearLayout
            android:id="@+id/surveyAddAnswer"
            style="@style/BottomSheetMenuItem"
            >

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_add"
                app:tint="?android:attr/textColorPrimary"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/bottomsheet_item_textview_margin_left"
                android:text="@string/survey_add_answer"
                android:textSize="?attr/textSizeNormal"
                />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/separator_line_height"
            android:background="?attr/lineColor"
            />

        <LinearLayout
            android:id="@+id/surveySave"
            style="@style/BottomSheetMenuItem"
            >

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_check"
                app:tint="?android:attr/textColorPrimary"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/bottomsheet_item_textview_margin_left"
                android:text="@string/survey_save"
                android:textSize="?attr/textSizeNormal"
                />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
